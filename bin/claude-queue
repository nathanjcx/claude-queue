#!/usr/bin/env bash
set -euo pipefail

Q="${CLAUDE_QUEUE_DIR:-$PWD/.claude-queue}"
SELF=$0; while [ -L "$SELF" ]; do SELF=$(readlink "$SELF"); done
REPO=$(cd "$(dirname "$SELF")/.." && pwd)
mkdir -p "$Q/pending" "$Q/done" "$Q/logs"
# The queue lives in the working directory, which is usually a repository — so it ignores itself.
# Without this, a queued task and the transcript of running it sit untracked inside the project, and
# one `git add -A` publishes both. A task is arbitrary text: often a key, a token, a private URL.
[ -f "$Q/.gitignore" ] || printf '*\n' > "$Q/.gitignore"
chmod 700 "$Q" 2>/dev/null || true

usage() {
  cat <<U
claude-queue — run Claude Code tasks one at a time

  add <task>     queue a task (or pipe it on stdin)
  list           show pending tasks
  rm <n>         remove task n
  run [args]     run tasks with claude -p until the queue is empty; args go to claude
  auto on|off    let an interactive session pick up tasks when it finishes
  install        PATH symlink, hooks in ~/.claude/settings.json, /q command
U
}

add() {
  local text last id file
  [ $# -gt 0 ] && text="$*" || text=$(cat)
  last=$(ls "$Q/pending" "$Q/done" | grep -oE '^[0-9]{4}' | sort | tail -1 || true)
  id=$(printf '%04d' $(( 10#${last:-0} + 1 )))
  # The number alone. The task used to be summarised into the filename, which put whatever was
  # typed into `ls`, into shell completion, and into every backup of the tree — and a filename is
  # the one part of a file you can't read and then decide not to keep. `list` reads the first line
  # out of the file instead, so nothing is lost from the display.
  file="$Q/pending/$id.md"
  printf '%s\n' "$text" > "$file"
  chmod 600 "$file" 2>/dev/null || true
  echo "queued #$id  $(printf '%s' "$text" | head -1)"
}

list() {
  local f i=0
  for f in "$Q/pending"/*.md; do
    [ -e "$f" ] || { echo "queue is empty"; return; }
    printf '%2d. %s\n' $((++i)) "$(head -1 "$f")"
  done
}

remove() {
  local f; f=$(ls "$Q/pending"/*.md 2>/dev/null | sed -n "${1:?usage: rm <n>}p")
  [ -n "$f" ] || { echo "no task $1"; exit 1; }
  echo "removed: $(head -1 "$f")"; rm "$f"
}

run() {
  local f name log first
  while f=$(ls "$Q/pending"/*.md 2>/dev/null | head -1) && [ -n "$f" ]; do
    name=$(basename "$f" .md); log="$Q/logs/$name.log"; first=$(head -1 "$f")
    echo "▶ $first"
    if CLAUDE_QUEUE_BATCH=1 claude -p "$(cat "$f")" --permission-mode "${CLAUDE_QUEUE_PERMISSION_MODE:-acceptEdits}" "$@" </dev/null 2>&1 | tee "$log"; then
      mv "$f" "$Q/done/"; echo "✔ #$name  $first"
    else
      echo "✘ #$name  (left in pending, log: $log)"; exit 1
    fi
  done
  echo "queue empty"
}

auto() {
  case "${1:-}" in
    on)  touch "$Q/auto"; echo "auto on" ;;
    off) rm -f "$Q/auto"; echo "auto off" ;;
    *)   [ -f "$Q/auto" ] && echo on || echo off ;;
  esac
}

setup() {
  local bin="" candidate s=~/.claude/settings.json
  # Prefer somewhere writable that is *also* on PATH. Picking on writability alone can drop the
  # symlink where the shell will never look, which installs cleanly and then fails at the first /q
  # with "command not found" — with nothing to suggest the install was the problem.
  for candidate in /opt/homebrew/bin /usr/local/bin ~/.local/bin; do
    [ -w "$candidate" ] || continue
    [ -n "$bin" ] || bin="$candidate"
    case ":$PATH:" in *":$candidate:"*) bin="$candidate"; break ;; esac
  done
  [ -n "$bin" ] || bin=~/.local/bin
  mkdir -p "$bin" ~/.claude/commands
  ln -sf "$REPO/bin/claude-queue" "$bin/claude-queue"
  # /q calls the script by absolute path, the same way the hooks do. Claude Code is not
  # always started from a login shell — an app that spawns it, a launchd job, an IDE — and such
  # a session inherits the bare system PATH, where no symlink of ours will ever be found. The
  # PATH symlink above is for typing `claude-queue` in a terminal; /q must not depend on it.
  local command; command=$(<"$REPO/commands/q.md")
  printf '%s\n' "${command//\{\{CLAUDE_QUEUE\}\}/$REPO/bin/claude-queue}" > ~/.claude/commands/q.md
  [ -f "$s" ] || echo '{}' > "$s"
  grep -q stop-hook.sh "$s" || { jq --arg c "$REPO/hooks/stop-hook.sh" '.hooks.Stop += [{hooks:[{type:"command",command:$c}]}]' "$s" > "$s.tmp" && mv "$s.tmp" "$s"; }
  grep -q session-start.sh "$s" || { jq --arg c "$REPO/hooks/session-start.sh" '.hooks.SessionStart += [{matcher:"startup",hooks:[{type:"command",command:$c}]}]' "$s" > "$s.tmp" && mv "$s.tmp" "$s"; }
  echo "installed: $bin/claude-queue, /q command, Stop and SessionStart hooks"
  command -v claude-queue >/dev/null 2>&1 || cat <<WARN
note: $bin is not on your PATH. /q works regardless, but to type claude-queue in a
      terminal add it to your shell profile:  export PATH="$bin:\$PATH"
WARN
}

case "${1:-}" in
  add)     shift; add "$@" ;;
  list|ls) list ;;
  rm)      remove "${2:-}" ;;
  run)     shift; run "$@" ;;
  auto)    auto "${2:-}" ;;
  install) setup ;;
  q)       shift; [ $# -gt 0 ] && text="$*" || text=$(cat)
           [ -n "${text//[[:space:]]/}" ] || { list; exit; }
           touch "$Q/auto"; printf '%s\n' "$text" | add; echo "pending:"; list ;;
  *)       usage ;;
esac
