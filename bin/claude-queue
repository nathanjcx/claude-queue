#!/usr/bin/env bash
# claude-queue — run Claude Code tasks one after another.
#
# Tasks are plain markdown files in .claude-queue/pending/. `run` picks the
# first one, runs it with `claude -p`, waits for it to fully finish, moves it
# to done/ (or failed/), then picks the next. Nothing runs in parallel.
set -euo pipefail

VERSION="0.1.0"
QUEUE_DIR="${CLAUDE_QUEUE_DIR:-$PWD/.claude-queue}"
PENDING="$QUEUE_DIR/pending"
DONE="$QUEUE_DIR/done"
FAILED="$QUEUE_DIR/failed"
LOGS="$QUEUE_DIR/logs"

# Resolve the repo this script lives in (follows a symlink from /usr/local/bin).
SELF="$0"
while [ -L "$SELF" ]; do
  target=$(readlink "$SELF")
  case "$target" in /*) SELF="$target" ;; *) SELF="$(dirname "$SELF")/$target" ;; esac
done
REPO_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
HOOK_SCRIPT="$REPO_DIR/hooks/stop-hook.sh"

usage() {
  cat <<USAGE
claude-queue $VERSION — run Claude Code tasks sequentially

usage: claude-queue <command> [args]

  add <prompt...>        queue a task (also: add -f file.md, or pipe on stdin)
  list                   show pending tasks in run order
  show <id>              print a task's full prompt
  edit <id>              open a task in \$EDITOR
  rm <id>                remove a pending task
  move <id> top|bottom   reorder a task
  clear                  remove all pending tasks
  run [opts] [-- args]   run pending tasks one at a time until the queue is empty
      -c, --continue        chain tasks in one Claude session (each sees the last)
      -k, --keep-going      don't stop the queue when a task fails
      -y, --yolo            pass --dangerously-skip-permissions
      -n, --dry-run         print what would run
      -- <args>             extra args passed straight to \`claude\`
  retry <id>             move a failed task back to pending
  status                 counts for pending / done / failed
  log <id>               print the output log for a task
  auto on|off            let the Stop hook feed queued tasks into an interactive session
  install-hook           add the Stop hook to ./.claude/settings.json

env:
  CLAUDE_QUEUE_DIR              queue location (default: ./.claude-queue)
  CLAUDE_QUEUE_PERMISSION_MODE  --permission-mode for runs (default: acceptEdits)
USAGE
}

die() { echo "claude-queue: $*" >&2; exit 1; }
ensure_dirs() { mkdir -p "$PENDING" "$DONE" "$FAILED" "$LOGS"; }

next_id() {
  local last
  last=$( (ls "$PENDING" "$DONE" "$FAILED" 2>/dev/null || true) | grep -E '^[0-9]{4}-' | sort | tail -1 | cut -c1-4)
  printf '%04d' $(( 10#${last:-0} + 1 ))
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-40
}

# find_task <dir> <id-or-prefix> -> path
find_task() {
  local dir="$1" id="$2" match
  id=$(printf '%04d' $(( 10#$id )) 2>/dev/null || printf '%s' "$id")
  match=$(ls "$dir"/"$id"-*.md 2>/dev/null | head -1 || true)
  [ -n "$match" ] || die "no task '$2' in $(basename "$dir")/"
  printf '%s' "$match"
}

first_pending() { ls "$PENDING"/*.md 2>/dev/null | head -1 || true; }

cmd_add() {
  local prompt=""
  if [ "${1:-}" = "-f" ]; then
    [ -n "${2:-}" ] || die "add -f needs a file"
    prompt=$(cat "$2")
  elif [ $# -gt 0 ]; then
    prompt="$*"
  else
    prompt=$(cat)
  fi
  [ -n "$(printf '%s' "$prompt" | tr -d '[:space:]')" ] || die "empty task"
  ensure_dirs
  local id slug file
  id=$(next_id)
  slug=$(slugify "$(printf '%s\n' "$prompt" | head -1)")
  file="$PENDING/$id-${slug:-task}.md"
  printf '%s\n' "$prompt" > "$file"
  echo "queued #$id  ${file#$PWD/}"
}

cmd_list() {
  ensure_dirs
  local f n=0
  for f in "$PENDING"/*.md; do
    [ -e "$f" ] || break
    n=$((n + 1))
    printf '%2d. %s  %s\n' "$n" "$(basename "$f" .md | cut -c1-4)" "$(head -1 "$f" | cut -c1-72)"
  done
  [ "$n" -gt 0 ] || echo "queue is empty"
}

cmd_show() { cat "$(find_task "$PENDING" "${1:?usage: show <id>}")"; }
cmd_edit() { "${EDITOR:-vi}" "$(find_task "$PENDING" "${1:?usage: edit <id>}")"; }

cmd_rm() {
  local f; f=$(find_task "$PENDING" "${1:?usage: rm <id>}")
  rm "$f"; echo "removed $(basename "$f" .md)"
}

cmd_clear() {
  ensure_dirs
  rm -f "$PENDING"/*.md
  echo "queue cleared"
}

cmd_move() {
  local target f slug i=0 ordered=()
  target=$(find_task "$PENDING" "${1:?usage: move <id> top|bottom}")
  case "${2:-}" in
    top)    ordered=("$target"); for f in "$PENDING"/*.md; do [ "$f" != "$target" ] && ordered+=("$f"); done ;;
    bottom) for f in "$PENDING"/*.md; do [ "$f" != "$target" ] && ordered+=("$f"); done; ordered+=("$target") ;;
    *)      die "usage: move <id> top|bottom" ;;
  esac
  # Renumber the whole queue in the new order, via temp names so nothing collides.
  for f in "${ordered[@]}"; do mv "$f" "$f.tmp"; done
  for f in "${ordered[@]}"; do
    i=$((i + 1)); slug=$(basename "$f" .md | cut -c6-)
    mv "$f.tmp" "$PENDING/$(printf '%04d' "$i")-$slug.md"
  done
  echo "reordered:"; cmd_list
}

cmd_retry() {
  local f; f=$(find_task "$FAILED" "${1:?usage: retry <id>}")
  mv "$f" "$PENDING/"; echo "requeued $(basename "$f" .md)"
}

cmd_status() {
  ensure_dirs
  printf 'pending %d   done %d   failed %d   auto-chain %s\n' \
    "$(ls "$PENDING"/*.md 2>/dev/null | wc -l | tr -d ' ')" \
    "$(ls "$DONE"/*.md 2>/dev/null | wc -l | tr -d ' ')" \
    "$(ls "$FAILED"/*.md 2>/dev/null | wc -l | tr -d ' ')" \
    "$([ -f "$QUEUE_DIR/auto" ] && echo on || echo off)"
}

cmd_log() {
  local id; id=$(printf '%04d' $(( 10#${1:?usage: log <id>} )))
  cat "$LOGS"/"$id"-*.log 2>/dev/null || die "no log for $id"
}

cmd_run() {
  local continue_session=0 keep_going=0 dry=0 yolo=0
  local extra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--continue)   continue_session=1 ;;
      -k|--keep-going) keep_going=1 ;;
      -y|--yolo)       yolo=1 ;;
      -n|--dry-run)    dry=1 ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown run option: $1" ;;
    esac
    shift
  done
  ensure_dirs
  command -v claude >/dev/null || die "claude not found on PATH"

  local f name prompt log started first=1 ran=0 failed=0
  while :; do
    f=$(first_pending)
    if [ -z "$f" ]; then
      echo "queue drained: $ran ran, $failed failed"
      [ "$failed" -eq 0 ]
      return
    fi
    name=$(basename "$f" .md)
    prompt=$(cat "$f")
    log="$LOGS/$name.log"

    local args=(-p "$prompt")
    if [ "$yolo" -eq 1 ]; then args+=(--dangerously-skip-permissions)
    else args+=(--permission-mode "${CLAUDE_QUEUE_PERMISSION_MODE:-acceptEdits}"); fi
    [ "$continue_session" -eq 1 ] && [ "$first" -eq 0 ] && args+=(--continue)
    [ ${#extra[@]} -gt 0 ] && args+=("${extra[@]}")

    if [ "$dry" -eq 1 ]; then
      echo "would run $name:"; printf '   %s\n' "$(head -1 "$f")"
      mv "$f" "$DONE/"; first=0; ran=$((ran + 1)); continue
    fi

    echo "▶ $name  ($(date '+%H:%M:%S'))"
    started=$(date +%s)
    { printf '### %s\n### %s\n\n' "$name" "$(date)"; printf '%s\n\n---\n\n' "$prompt"; } > "$log"
    # CLAUDE_QUEUE_BATCH tells the Stop hook to stay out of headless runs.
    if CLAUDE_QUEUE_BATCH=1 claude "${args[@]}" </dev/null 2>&1 | tee -a "$log"; then
      mv "$f" "$DONE/"
      echo "✔ $name  ($(( $(date +%s) - started ))s)"
    else
      mv "$f" "$FAILED/"
      failed=$((failed + 1))
      echo "✘ $name failed — see ${log#$PWD/}" >&2
      if [ "$keep_going" -eq 0 ]; then
        echo "stopping; fix and \`claude-queue retry ${name%%-*}\` then \`claude-queue run\`" >&2
        return 1
      fi
    fi
    first=0; ran=$((ran + 1))
  done
}

cmd_auto() {
  ensure_dirs
  case "${1:-}" in
    on)  touch "$QUEUE_DIR/auto"; echo "auto-chain on: the Stop hook will feed queued tasks into your interactive session" ;;
    off) rm -f "$QUEUE_DIR/auto"; echo "auto-chain off" ;;
    *)   die "usage: auto on|off" ;;
  esac
}

cmd_install_hook() {
  local settings=".claude/settings.json"
  mkdir -p .claude
  [ -f "$settings" ] || echo '{}' > "$settings"
  if grep -q "stop-hook.sh" "$settings"; then
    echo "hook already present in $settings"; return
  fi
  local tmp; tmp=$(mktemp)
  jq --arg cmd "$HOOK_SCRIPT" \
    '.hooks.Stop = ((.hooks.Stop // []) + [{"hooks":[{"type":"command","command":$cmd}]}])' \
    "$settings" > "$tmp" && mv "$tmp" "$settings"
  echo "added Stop hook to $settings"
  echo "next: claude-queue auto on   (the hook only chains while auto is on)"
}

case "${1:-}" in
  add)          shift; cmd_add "$@" ;;
  list|ls)      cmd_list ;;
  show)         shift; cmd_show "$@" ;;
  edit)         shift; cmd_edit "$@" ;;
  rm|remove)    shift; cmd_rm "$@" ;;
  move)         shift; cmd_move "$@" ;;
  clear)        cmd_clear ;;
  run)          shift; cmd_run "$@" ;;
  retry)        shift; cmd_retry "$@" ;;
  status)       cmd_status ;;
  log)          shift; cmd_log "$@" ;;
  auto)         shift; cmd_auto "$@" ;;
  install-hook) cmd_install_hook ;;
  -v|--version) echo "$VERSION" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1' (try --help)" ;;
esac
