#!/usr/bin/env bash
set -euo pipefail

Q="${CLAUDE_QUEUE_DIR:-$PWD/.claude-queue}"
SELF=$0; while [ -L "$SELF" ]; do SELF=$(readlink "$SELF"); done
REPO=$(cd "$(dirname "$SELF")/.." && pwd)
mkdir -p "$Q/pending" "$Q/done" "$Q/logs"

usage() {
  cat <<U
claude-queue — run Claude Code tasks one at a time

  add <task>     queue a task (or pipe it on stdin)
  list           show pending tasks
  rm <n>         remove task n
  run [args]     run tasks with claude -p until the queue is empty; args go to claude
  auto on|off    let an interactive session pick up tasks when it finishes
  install        PATH symlink, Stop hook in ~/.claude/settings.json, /q command
U
}

add() {
  local text last id slug
  [ $# -gt 0 ] && text="$*" || text=$(cat)
  last=$(ls "$Q/pending" "$Q/done" | grep -oE '^[0-9]{4}' | sort | tail -1 || true)
  id=$(printf '%04d' $(( 10#${last:-0} + 1 )))
  slug=$(printf '%s' "$text" | head -1 | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/-$//')
  printf '%s\n' "$text" > "$Q/pending/$id-$slug.md"
  echo "queued #$id  $(printf '%s' "$text" | head -1)"
}

list() {
  local f i=0
  for f in "$Q/pending"/*.md; do
    [ -e "$f" ] || { echo "queue is empty"; return; }
    printf '%2d. %s\n' $((++i)) "$(head -1 "$f")"
  done
}

remove() {
  local f; f=$(ls "$Q/pending"/*.md 2>/dev/null | sed -n "${1:?usage: rm <n>}p")
  [ -n "$f" ] || { echo "no task $1"; exit 1; }
  echo "removed: $(head -1 "$f")"; rm "$f"
}

run() {
  local f name log
  while f=$(ls "$Q/pending"/*.md 2>/dev/null | head -1) && [ -n "$f" ]; do
    name=$(basename "$f" .md); log="$Q/logs/$name.log"
    echo "▶ $(head -1 "$f")"
    if CLAUDE_QUEUE_BATCH=1 claude -p "$(cat "$f")" --permission-mode "${CLAUDE_QUEUE_PERMISSION_MODE:-acceptEdits}" "$@" </dev/null 2>&1 | tee "$log"; then
      mv "$f" "$Q/done/"; echo "✔ $name"
    else
      echo "✘ $name  (left in pending, log: $log)"; exit 1
    fi
  done
  echo "queue empty"
}

auto() {
  case "${1:-}" in
    on)  touch "$Q/auto"; echo "auto on" ;;
    off) rm -f "$Q/auto"; echo "auto off" ;;
    *)   [ -f "$Q/auto" ] && echo on || echo off ;;
  esac
}

setup() {
  local bin s=~/.claude/settings.json
  for bin in /opt/homebrew/bin /usr/local/bin ~/.local/bin; do [ -w "$bin" ] && break; done
  mkdir -p "$bin" ~/.claude/commands
  ln -sf "$REPO/bin/claude-queue" "$bin/claude-queue"
  cp "$REPO/commands/q.md" ~/.claude/commands/q.md
  [ -f "$s" ] || echo '{}' > "$s"
  grep -q stop-hook.sh "$s" || { jq --arg c "$REPO/hooks/stop-hook.sh" '.hooks.Stop += [{hooks:[{type:"command",command:$c}]}]' "$s" > "$s.tmp" && mv "$s.tmp" "$s"; }
  echo "installed: $bin/claude-queue, /q command, Stop hook"
}

case "${1:-}" in
  add)     shift; add "$@" ;;
  list|ls) list ;;
  rm)      remove "${2:-}" ;;
  run)     shift; run "$@" ;;
  auto)    auto "${2:-}" ;;
  install) setup ;;
  q)       shift; [ $# -eq 0 ] && list || { touch "$Q/auto"; add "$@"; } ;;
  *)       usage ;;
esac
